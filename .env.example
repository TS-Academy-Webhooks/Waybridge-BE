PORT=3000
MONGO_URI=mongodb://127.0.0.1:27017/logistics
JWT_SECRET=replace-this-example-with-at-least-32-random-characters
ADMIN_NAME=Platform Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-this-example-with-a-unique-password
NODE_ENV=development
ALLOW_LOCALHOST_WEBHOOKS=true
CORS_ORIGIN=http://localhost:5173
REFRESH_COOKIE_SAME_SITE=strict
ENABLE_DEMO_RECEIVER=false